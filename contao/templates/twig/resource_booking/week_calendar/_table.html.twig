{% trans_default_domain "contao_default" %}

{#
    Table of the active week (rendered on the server, see _view.html.twig). The day displayed on small
    screens (data-activedayindex, aria-pressed of the day tabs) is set by app.js.
#}
{% block rbb_week_calendar_window__table %}
    {% if rows is not empty %}
        {# Day selection, only displayed on small screens (one day at a time) #}
        {% block rbb_week_calendar_window__day_tabs %}
            <div class="rbb-day-tabs" role="group" aria-label="{{ ('RBB.filterDay')|trans }}">
                {% for weekday in weekdays %}
                    <button id="rbbDayTab_{{ moduleKey }}_{{ weekday.index }}" type="button" class="rbb-day-tab" data-rbb-day="{{ weekday.index }}" data-rbb-tstamp="{{ weekday.tstamp }}" data-day-index="{{ weekday.index }}" aria-pressed="false" aria-label="{{ weekday.title }}, {{ weekday.date }}">
                        <span class="rbb-day-tab-name" aria-hidden="true">{{ weekday.titleShort|default(weekday.title|slice(0, 2)) }}</span>
                        <span class="rbb-day-tab-date" aria-hidden="true">{{ weekday.tstamp|date('j.n.') }}</span>
                    </button>
                {% endfor %}
            </div>
        {% endblock %}

        {# The div based layout is exposed to assistive technology as a table (rows, column and row headers) #}
        <div class="rbb-layout-table rbb-booking-table-main" role="table" aria-label="{{ ('RBB.weekCalendar')|trans }}: {{ activeResource.title|default('') }}, {{ activeWeek.daySpan|default('') }}">
            <div class="rbb-layout-box-inner" role="rowgroup">
                <div class="rbb-layout-row rbb-layout-row-head" role="row">
                    <div class="rbb-layout-cell rbb-cell-headline rbb-time-slot-indicator" role="columnheader"><strong>{{ ('RBB.time')|trans }}</strong></div>
                    {% for weekday in weekdays %}
                        <div class="rbb-layout-cell rbb-cell-headline" role="columnheader" data-day-index="{{ weekday.index }}"><strong class="rbb-weekday-title">{{ weekday.title }}</strong> <span class="rbb-weekday-date">{{ weekday.date }}</span></div>
                    {% endfor %}
                </div>

                {% for row in rows %}
                    {% set rowIndex = loop.index0 %}
                    {% set timeSlot = timeSlots[rowIndex]|default({}) %}
                    <div data-row-index="{{ rowIndex }}" id="{{ row.rowData.cssRowId|default('') }}" class="rbb-layout-row {{ row.rowData.cssRowClass|default('') }}" role="row">
                        {# time indicator #}
                        <div class="rbb-layout-cell rbb-time-slot-indicator {{ timeSlot.cssClass|default('') }}" role="rowheader">{{ timeSlot.timeSpanString|default('') }}</div>
                        {# slots #}
                        {% for slot in row.cellData %}
                            {% set colIndex = loop.index0 %}
                            {% set hasUnconfirmedBookings = slot.hasBookings and slot.bookings|filter(booking => not booking.confirmed)|length > 0 %}
                            <div class="rbb-layout-cell rbb-time-slot-cell {{ timeSlot.cssClass|default('') }}" role="cell" data-day-index="{{ slot.index }}" data-ismemberloggedin="{{ slot.isMemberLoggedIn ? 'true' : 'false' }}" data-iscancelable="{{ slot.isCancelable ? 'true' : 'false' }}" data-isfullybooked="{{ slot.isFullyBooked ? 'true' : 'false' }}" data-isbookable="{{ not slot.isCancelable and slot.isBookable ? 'true' : 'false' }}" data-isbooked="{{ slot.hasBookings ? 'true' : 'false' }}" data-isoutsidebookingwindow="{{ not slot.isInBookingWindow ? 'true' : 'false' }}" data-isavailableonweekday="{{ slot.isAvailableOnWeekday ? 'true' : 'false' }}" data-isinblockedperiod="{{ slot.isInBlockedPeriod ? 'true' : 'false' }}" data-hasunconfirmedbookings="{{ hasUnconfirmedBookings ? 'true' : 'false' }}">
                                {{ block('rbb_week_calendar_window__time_slot_cell') }}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
