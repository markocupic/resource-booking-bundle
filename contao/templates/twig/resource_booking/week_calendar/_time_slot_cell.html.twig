{% trans_default_domain "contao_default" %}

{#
    Content of a cell of the week table (rendered on the server, see _table.html.twig).

    Variables: slot (WeekCalendar\SlotPresenter, changed by the listeners of the AjaxResponseEvent),
    rowIndex and colIndex (position of the slot, unique ids of the buttons), activeResource and
    hasLoggedInUser.

    The buttons carry the data of the booking window (handled in app.js):
      - book:   data-rbb-action="book", data-rbb-slot (time slot), data-rbb-resource
      - cancel: data-rbb-action="cancel", data-rbb-booking-id, data-rbb-booking-uuid
#}
{% block rbb_week_calendar_window__time_slot_cell %}
    <div class="rbb-time-slot-cell-inner">
        {% if slot.isInBlockedPeriod and slot.blockedPeriodDescription|default and not slot.hasBookings %}
            <div class="rbb-cell-blocked-period-label">{{ slot.blockedPeriodDescription }}</div>
        {% endif %}
        {% if not slot.isAvailableOnWeekday and not slot.isInBlockedPeriod and not slot.hasBookings %}
            <div class="rbb-cell-not-available-label">{{ ('RBB.notAvailable')|trans }}</div>
        {% endif %}
        {# Past slots or slots outside the booking period have no visible text: name the state for screen readers #}
        {% if not slot.isInBookingWindow and not slot.hasBookings and not slot.isInBlockedPeriod and slot.isAvailableOnWeekday %}
            <span class="rbb-visually-hidden">{{ ('RBB.notBookable')|trans }}</span>
        {% endif %}
        {% if slot.isBookable and not slot.hasBookings and slot.isInBookingWindow %}
            <div class="rbb-cell-free-label">{{ ('RBB.free')|trans }}</div>
        {% endif %}
        {% if slot.isAvailableOnWeekday and not slot.isInBlockedPeriod and activeResource.itemsAvailable|default(1) > 1 and slot.remainingItems > 0 and slot.isInBookingWindow %}
            <div class="rbb-cell-booking-still-available-box" title="{{ ('RBB.stillAvailable')|trans }}: {{ slot.remainingItems }}">+ {{ slot.remainingItems }}</div>
        {% endif %}
        {% if slot.hasBookings %}
            {% for booking in slot.bookings %}
                <div class="rbb-booked-item" data-confirmed="{{ booking.confirmed ? 'true' : 'false' }}" data-bookedbyanonymous="{{ booking.bookedByAnonymous ? 'true' : 'false' }}">
                    <span class="rbb-booked-item-header">
                        {% if booking.isOwn %}<span class="rbb-cell-booking-own-icon">{{ rbb_icon('fa-check-circle')|raw }}<span class="rbb-visually-hidden">{{ ('RBB.legend.own')|trans }}:</span></span>{% endif %}
                        {% if booking.bookedByFullname|default %}<span class="rbb-cell-booking-owner-box">{{ booking.bookedByFullname }}</span>{% endif %}
                        {% if activeResource.itemsAvailable|default(1) > 1 %}<span class="item-counter-box"> (-{{ booking.itemsBooked }})</span>{% endif %}
                    </span>
                    {# Data about the booking person selected in the module settings (apart from the name), e.g. company, city,
                       phone. Single fields are also available as booking.bookedBy<Field>, e.g. booking.bookedByCity.
                       Other fields of the member (independent of the module settings, only for logged-in members), e.g.:
                       {% set member = rbb_booking_member(booking) %}
                       {% if member.street|default %}<li class="rbb-cell-booking-member-detail">{{ member.street }}</li>{% endif %}
                       Careful: whatever the template displays is visible to all logged-in members. #}
                    {% block rbb_week_calendar_window__time_slot_cell__member_details %}
                        {% if booking.bookedByDetails|default([]) is not empty %}
                            <ul class="rbb-cell-booking-member-details">
                                {% for detail in booking.bookedByDetails %}
                                    <li class="rbb-cell-booking-member-detail" data-field="{{ detail.field }}" title="{{ detail.label }}"><span class="rbb-visually-hidden">{{ detail.label }}: </span>{{ detail.value }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endblock %}
                    {# Feel free and add more details about the booking (tl_resource_booking, if displayed in the module) #}
                    {% if booking.bookingDescription|default %}<span class="rbb-cell-booking-description-box"><small>{{ booking.bookingDescription }}</small></span>{% endif %}
                    {% if not booking.confirmed %}<span class="rbb-cell-booking-unconfirmed-box"><small>{{ ('RBB.awaitingConfirmation')|trans }}</small></span>{% endif %}
                    {% if booking.canCancel %}
                        <button id="rbbCancel_{{ moduleKey }}_{{ rowIndex }}_{{ colIndex }}_{{ loop.index0 }}" class="rbb-btn-icon rbb-btn-cancel-booking" type="button" data-rbb-action="cancel" data-rbb-booking-id="{{ slot.memberBooking.id|default(0) }}" data-rbb-booking-uuid="{{ slot.memberBooking.bookingUuid|default('') }}" title="{{ ('RBB.cancelResource')|trans }}" aria-label="{{ ('RBB.cancelResource')|trans }}: {{ slot.datimSpanString }}">
                            {{ rbb_icon('fa-times-circle','rbb-icon-cancel-booking')|raw }}
                        </button>
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
        {# Buttons to book the slot: override this block to add e.g. a link for guests #}
        {% block rbb_week_calendar_window__time_slot_cell__actions %}
            {% if hasLoggedInUser and slot.isBookable and not slot.isCancelable %}
                <button id="rbbBook_{{ moduleKey }}_{{ rowIndex }}_{{ colIndex }}" class="rbb-btn-icon rbb-btn-booking" type="button" data-rbb-action="book" data-rbb-slot="{{ slot.bookingCheckboxValue }}" data-rbb-resource="{{ slot.resourceId }}" title="{{ ('RBB.bookResource')|trans }}" aria-label="{{ ('RBB.bookResource')|trans }}: {{ slot.datimSpanString }}">
                    {{ rbb_icon('fa-plus')|raw }}<span class="rbb-btn-booking-label">{{ ('RBB.book')|trans }}</span>
                </button>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
