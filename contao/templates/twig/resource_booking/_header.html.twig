{% trans_default_domain "contao_default" %}

{#
    Header (rendered on the server, see week_calendar/_view.html.twig): resource type, resource and
    displayed days of the active week on the left, the logged in member on the right.
#}
{% block rbb_header %}
    <div class="rbb-header">
        {% block rbb_header__title %}
            {% if activeResource.title|default %}
                <div class="rbb-header-title">
                    {% if activeResourceType.title|default %}<span class="rbb-header-kicker">{{ activeResourceType.title }}</span>{% endif %}
                    <h2 class="rbb-header-headline">{{ activeResource.title }}</h2>
                    {% if activeWeek.daySpan|default %}<span class="rbb-header-week">{{ ('RBB.calWeekShort')|trans }} {{ activeWeek.calWeek }} · {{ activeWeek.daySpan }}</span>{% endif %}
                </div>
            {% endif %}
        {% endblock %}
        {{ block('rbb_logged_in_user') }}
    </div>
{% endblock %}
