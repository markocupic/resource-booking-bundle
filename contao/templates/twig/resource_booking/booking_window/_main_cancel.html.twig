{% trans_default_domain "contao_default" %}

{# Cancel window (rendered on the server, see _view.html.twig) #}
{% block rbb_booking_window__cancel_booking_form %}
    {# Start header #}
    {% block rbb_booking_window__cancel_booking_form__header %}
        <div class="rbb-booking-window-header">
            <h3 class="rbb-booking-window-header-title" id="rbbBookingWindowTitle_{{ moduleKey }}">
                {{ ('RBB.cancel')|trans }}: {{ activeResource.title|default('') }}
            </h3>
            <button type="button" data-rbb-action="close" class="rbb-close-window" aria-label="{{ ('RBB.close')|trans }}" title="{{ ('RBB.close')|trans }}">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endblock %}
    {# Stop header #}

    {{ block('rbb_booking_window__info_table') }}

    {# Start delete repetitions switch #}
    {% block rbb_booking_window__cancel_booking_form__delete_repetitions_switch %}
        {% if bookingWindow.showForm %}
            <div class="rbb-form-check rbb-delete-repetitions">
                <input type="checkbox" class="rbb-form-check-input" id="deleteRepetitions_{{ moduleKey }}" name="deleteRepetitions" value="1">
                <label class="rbb-form-check-label" for="deleteRepetitions_{{ moduleKey }}">{{ ('RBB.deleteRepetitions')|trans }}</label>
            </div>
        {% endif %}
    {% endblock %}
    {# End delete repetitions switch #}

    {{ block('rbb_messages') }}

    {# Start footer #}
    {% block rbb_booking_window__cancel_booking_form__footer %}
        <div class="rbb-booking-window-footer">
            {% if bookingWindow.showForm %}
                <button type="button" class="rbb-btn rbb-btn--danger" data-rbb-action="cancel-booking">
                    {{ ('RBB.cancelResource')|trans }}
                </button>
            {% endif %}
            <button type="button" class="rbb-btn rbb-btn--secondary rbb-js-close-booking-window" data-rbb-action="close">
                {{ ('RBB.close')|trans }}
            </button>
        </div>
    {% endblock %}
    {# End footer #}
{% endblock %}
