{% trans_default_domain "contao_default" %}

{% do addJavascriptResource('assets/contao-component-bootstrap/bootstrap/dist/js/bootstrap.bundle.min.js|static') %}
{% do addJavascriptResource('bundles/markocupicresourcebooking/vuejs/vue.global.js') %}
{% do addJavascriptResource('bundles/markocupicresourcebooking/app.js|static') %}
{% do addCssResource('assets/contao-component-bootstrap/bootstrap/dist/css/bootstrap.min.css') %}
{% do addCssResource('assets/contao-component-fontawesome-free/fontawesomefree/css/all.min.css') %}
{% do addCssResource('bundles/markocupicresourcebooking/css/frontend.min.css') %}

{% extends '@Contao/block_unsearchable' %}

{% block content %}
    <div id="resourceBookingApp_{{ moduleKey }}" v-cloak>
        <div class="rbb-app" v-bind:class="isReady ? 'rbb-is-ready' : ''">

            <div class="rbb-logged-in-user-data mb-2"><strong>{{ ('RBB.loggedInAs')|trans }}:</strong> {{ insert_tag('user::firstname') }} {{ insert_tag('user::lastname') }}</div>

            <template v-if="isReady === false && lastResponseCode === 200">
                <div class="text-center mt-5">
                    <div class="fa-5x rbb-loading-spinner">
                        <i class="fa-solid fa-sync fa-spin"></i>
                    </div>
                    <div role="status">
                        <span class="sr-only">{{ ('RBB.loading')|trans }}</span>
                    </div>
                </div>
            </template>

            <template v-if="isReady === false && lastResponseCode !== 200">
                <div class="text-muted mt-2" v-if="lastResponseCode === 401">
                    {{ ('RBB.ERR.401')|trans }}
                </div>
                <div class="text-muted mt-2" v-else>
                    {{ ('RBB.ERR.general')|trans }}
                </div>
            </template>

            <!-- vue application container -->
            <div class="rbb-vue-application">
                <!-- main window / mode === 'main-window'-->
                <div class="rbb-main-window" v-if="mode === 'main-window'">

                    <div v-if="activeResource.description" class="rbb-message-box mt-4">
                        <div class="rbb-resource-description alert alert-info d-flex pt-3 pb-3">
                            <i class="fa-2x me-3 fa-solid fa-exclamation-circle"></i>
                            <span>[[ activeResource.description ]]</span>
                        </div>
                    </div>

                    {% include('@Contao_MarkocupicResourceBookingBundle/rbb_filter_board_partial.html.twig') %}
                    {% include('@Contao_MarkocupicResourceBookingBundle/rbb_booking_table_partial.html.twig') %}

                </div>
                <!-- end main window / mode === 'main-window'-->

                <!-- booking window mode === 'booking-window'-->
                <div class="rbb-booking-window" v-if="mode === 'booking-window'" v-if="userHasLoggedIn">
                    {% include('@Contao_MarkocupicResourceBookingBundle/rbb_booking_window_partial.html.twig') %}
                </div>
                <!-- End booking window -->

            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            new ResourceBookingApp('#resourceBookingApp_{{ moduleKey }}', {
                'requestToken': '{{ csrfToken }}',
                'moduleKey': '{{ moduleKey }}',
                'audio': {
                    'notifyOnNewBookingsAudio': 'bundles/markocupicresourcebooking/audio/booking-alert.mp3'
                },
                'autocloseWindowsAfter': 5000,
                'enableAudio': true,
                'callbacks': {
                    // Callback function to be executed before a booking request is fired
                    onBeforeBookingRequest: function (objFormData) {
                        // return false will prevent submitting
                        return true;
                    },
                    // Callback function to be executed after a booking request was fired
                    onAfterBookingRequest: function () {
                    },
                }
            });
        });
    </script>
{% endblock %}
