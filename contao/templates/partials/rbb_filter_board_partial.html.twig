{% trans_default_domain "contao_default" %}

<!-- filter board -->
<form class="rbb-filter-board-form mt-5" action="{{ app.request.getUri() }}" method="get">
    <div v-if="filterBoard" class="row gx-2">
        <div class="rbb-go-back-one-week col-sm-1 mb-2">
            <button v-on:click="jumpWeekRequest(filterBoard.jumpPrevWeek.tstamp,$event)" v-bind:data-tstamp="filterBoard.jumpPrevWeek.tstamp" role="button" class="btn btn-primary w-100" title="{{ ('RBB.1WeekBack')|trans }}" v-bind:class="filterBoard.jumpPrevWeek.disabled ? 'disabled' : ''" v-bind:aria-disabled="filterBoard.jumpPrevWeek.disabled ? 'true' : 'false'" :disabled="filterBoard.jumpPrevWeek.disabled"><i class="fa-solid fa-chevron-left"></i></button>
        </div>

        <div class="rbb-ressource-type-select col-sm-3 mb-2">
            <label for="ctrlResType_{{ moduleKey }}" class="d-none">{{ ('RBB.resourceType')|trans }}</label>
            <select id="ctrlResType_{{ moduleKey }}" class="form-control w-100" name="resType" v-model="activeResourceTypeId">
                <option value="undefined">{{ ('RBB.formOptionSelectResourceType')|trans }}</option>
                <option v-for="(resourceType, index) in filterBoard.resourceTypes" v-bind:value="resourceType.id">[[ resourceType.title ]]</option>
            </select>
        </div>

        <div class="rbb-ressource-select col-sm-3 mb-2">
            <label for="ctrlRes_{{ moduleKey }}" class="d-none">{{ ('RBB.resource')|trans }}</label>
            <select id="ctrlRes_{{ moduleKey }}" class="form-control w-100" name="res" v-model="activeResourceId" :disabled="activeResourceTypeId === 'undefined'">
                <option value="undefined">{{ ('RBB.formOptionSelectResource')|trans }}</option>
                <option v-for="(resource, index) in filterBoard.resources" v-bind:value="resource.id">[[ resource.title ]]</option>
            </select>
        </div>

        <div class="rbb-week-select col-sm-4 mb-2">
            <label for="date_{{ moduleKey }}" class="d-none">{{ ('RBB.timeSpan')|trans }}</label>
            <select id="date_{{ moduleKey }}" :disabled="!rows.length" class="rbb-time-span-select form-control w-100" name="date" v-model="activeWeekTstamp">
                <option v-for="(week, index) in filterBoard.weekSelection" v-bind:class="week.cssClass" v-bind:value="week.tstampBeginnWeek">[[ week.optionText ]]</option>
            </select>
        </div>

        <div class="rbb-go-ahead-one-week col-sm-1 mb-2">
            <button v-on:click="jumpWeekRequest(filterBoard.jumpNextWeek.tstamp,$event)" v-bind:data-tstamp="filterBoard.jumpNextWeek.tstamp" role="button" class="btn btn-primary w-100" title="{{ ('RBB.1WeekAhead')|trans }}" v-bind:class="filterBoard.jumpNextWeek.disabled ? 'disabled' : ''" v-bind:aria-disabled="filterBoard.jumpNextWeek.disabled ? 'true' : 'false'" :disabled="filterBoard.jumpNextWeek.disabled"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>

    <!-- Error & info messages -->
    <div class="rbb-filter-form-messages mt-5" v-if="messages">
        <div v-if="messages.info" class="alert alert-info">[[ messages.info ]]</div>
        <div v-if="messages.error" class="alert alert-error">[[ messages.error ]]</div>
        <div v-if="messages.confirmation" class="alert alert-success">[[ messages.confirmation ]]</div>
    </div>
    <!-- End error & info messages -->
</form>
<!-- End filter board -->
