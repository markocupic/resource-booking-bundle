{% trans_default_domain "contao_default" %}

<template v-if="bookingWindow.action === 'showBookingForm'">
    <div class="rbb-booking-window-header bg-primary d-flex justify-content-between">
        <h3 class="rbb-booking-window-header-title m-3" v-if="bookingWindow.action === 'showBookingForm'">
            {{ ('RBB.book')|trans }}: [[ activeResource.title ]]
        </h3>
        <button class="rbb-close-window bg-primary" type="button" v-on:click="hideBookingWindow" aria-label="Close" title="{{ ('RBB.close')|trans }}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    {% include('@Contao_MarkocupicResourceBookingBundle/rbb_info_table_partial.html.twig') %}

    <!-- Messages -->
    <template v-if="bookingWindow.response.messages">
        <div class="rbb-message-box mt-4">
            <div class="alert alert-success d-flex pt-3 pb-3" v-if="bookingWindow.response.messages.confirmation !== null">
                <i class="fa-2x me-3 fa-solid fa-check-circle"></i><span>[[ bookingWindow.response.messages.confirmation ]]</span>
            </div>
            <div class="alert alert-danger d-flex pt-3 pb-3" v-if="bookingWindow.response.messages.error !== null">
                <i class="fa-2x me-3 fa-solid fa-exclamation-circle"></i><span>[[ bookingWindow.response.messages.error ]]</span>
            </div>
            <div class="alert alert-info d-flex pt-3 pb-3" v-if="bookingWindow.response.messages.info !== null">
                <i class="fa-2x me-3 fa-solid fa-info-circle"></i><span>[[ bookingWindow.response.messages.info ]]</span>
            </div>
            <p v-if="bookingWindow.response.bookingProcessSucceeded" class="rbb-input-help-text">
                <small>{{ ('RBB.MSG.windowClosesAutomatically')|trans }}</small>
            </p>
        </div>
    </template>
    <!-- End messages -->

    <template v-if="!bookingWindow.response.bookingProcessSucceeded">
        <template v-if="!bookingWindow.response.bookingValidationProcessSucceeded">
            <!-- start collapse -->
            <div class="mt-4">
                <button aria-controls="bookingPreview" aria-expanded="false" class="btn btn-sm btn-danger" data-bs-target="#bookingPreview_{{ moduleKey }}" data-bs-toggle="collapse" type="button">
                    {{ ('RBB.showOccupiedResources')|trans }}
                </button>
            </div>

            <div class="rbb-booking-preview-table rbb-layout-table collapse mt-4" id="bookingPreview_{{ moduleKey }}">
                <div class="rbb-layout-box-inner">
                    <div class="d-flex" v-bind:class="!slot.isBookable ? 'not-bookable' : 'bookable'" v-for="(slot, index) in bookingWindow.response.slotSelection">
                        <div class="rbb-layout-cell">
                            <small>[[ slot.datimSpanString ]]: </small>
                        </div>
                        <div class="rbb-layout-cell">
                            <span v-if="slot.invalidDate"><small>{{ ('RBB.ERR.invalidStartOrEndTime')|trans }}</small></span>
                            <span v-else-if="!slot.enoughItemsAvailable"><small>{{ ('RBB.ERR.thisSlotHasNotEnoughItemsAvailable')|trans }}</small></span>
                            <span v-else-if="slot.isFullyBooked"><small>{{ ('RBB.ERR.resourceIsAlreadyFullyBooked')|trans }}</small></span>
                            <span v-else><small>{{ ('RBB.MSG.resourceAvailable')|trans }}</small></span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end collapse -->
        </template>

        <form class="rbb-booking-form rbb-js-booking-form mt-4">
            <div class="row gy-4">
                <!-- start booking table -->
                <div class="rbb-layout-table rbb-booking-table-booking-form col-12 col-xl-6" v-if="rows.length > 0">
                    <div class="rbb-layout-box-inner">

                        <!-- headline -->
                        <div class="d-flex">
                            <div class="rbb-layout-cell rbb-cell-headline rbb-time-slot-indicator"><strong>{{ ('RBB.time')|trans }}</strong></div>
                            <div class="rbb-layout-cell rbb-cell-headline" v-bind:data-day-index="weekday.index" v-for="(weekday, index) in weekdays"><strong>[[ weekday.titleShort ]]</strong></div>
                        </div>

                        <!-- body -->
                        <div class="d-flex" v-bind:class="row.rowData.cssRowClass" v-bind:data-row-index="rowIndex" v-for="(row, rowIndex) in rows">
                            <div class="rbb-layout-cell rbb-time-slot-indicator">[[ timeSlots[rowIndex].timeSpanString ]]</div>
                            <div class="rbb-layout-cell rbb-time-slot-cell" v-bind:data-day-index="slot.index" v-bind:data-isbookable="slot.isBookable && slot.isDateInPermittedRange" v-bind:data-isbooked="slot.hasBookings" v-bind:data-isfullybooked="slot.isFullyBooked" v-bind:data-isinvaliddate="!slot.isDateInPermittedRange" v-for="(slot, colIndex) in row.cellData">
                                <div v-if="slot.isBookable && !slot.isFullyBooked">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" v-bind:id="slot.bookingCheckboxId" v-bind:value="slot.bookingCheckboxValue" v-model="bookingWindow.selectedTimeSlots" v-on:change="bookingFormValidationRequest()">
                                        <label class="form-check-label" v-bind:for="slot.bookingCheckboxId"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end booking table -->

                <!-- booking form inputs -->
                <div class="rbb-layout-box rbb-booking-form-inputs col-12 col-xl-6">
                    <div class="rbb-layout-box-inner">
                        <div class="form-group" v-if="parseInt(activeResource.itemsAvailable) > 1">
                            <label for="ctrlItemsBooked_{{ moduleKey }}">{{ ('RBB.formLegendItems')|trans }}</label>
                            <select class="rbb-ctrl-items-booked form-control" id="ctrlItemsBooked_{{ moduleKey }}" name="itemsBooked" v-on:change="bookingFormValidationRequest()">
                                <option v-bind:value="i" v-for="i in parseInt(activeResource.itemsAvailable)"> [[ i ]] {{ ('RBB.pieces')|trans }}</option>
                            </select>
                            <small class="rbb-items-booked-help rbb-input-help-text">{{ ('RBB.formHelpItems')|trans }}</small>
                        </div>

                        <div class="form-group mt-4">
                            <label for="ctrlBookingDescription_{{ moduleKey }}">{{ ('RBB.formLegendDescription')|trans }}</label>
                            <input class="rbb-ctrl-booking-description form-control" id="ctrlBookingDescription_{{ moduleKey }}" maxlength="50" name="bookingDescription" placeholder="Kurzbeschreibung eingeben" type="text">
                            <small class="rbb-booking-description-help rbb-input-help-text">{{ ('RBB.formHelpDescription')|trans }}</small>
                        </div>

                        <div class="form-group mt-4">
                            <label for="ctrlBookingRepeatStopWeekTstamp_{{ moduleKey }}">{{ ('RBB.formLegendRepetitions')|trans }}</label>
                            <select class="rbb-js-booking-repeat-stop-week-tstamp rbb-time-span-select form-control " id="ctrlBookingRepeatStopWeekTstamp_{{ moduleKey }}" name="bookingRepeatStopWeekTstamp" v-on:change="bookingFormValidationRequest()">
                                <option v-bind:value="row.tstamp" v-for="(row, rowIndex) in bookingRepeatsSelection">[[ row.optionText ]]</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end booking form inputs -->
        </form>
    </template>

    <!-- footer -->
    <div class="rbb-booking-window-footer mt-4">
        <button class="me-3 btn btn-primary" type="button" v-if="bookingWindow.response.bookingValidationProcessSucceeded && !bookingWindow.response.bookingProcessSucceeded" v-on:click="bookingRequest">
            {{ ('RBB.bookResource')|trans }}
        </button>
        <button class="btn btn-secondary" type="button" v-on:click="hideBookingWindow">
            {{ ('RBB.close')|trans }}
        </button>
    </div>

</template>
