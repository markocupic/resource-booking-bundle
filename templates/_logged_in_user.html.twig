{% trans_default_domain "contao_default" %}

{% block rbb_logged_in_user %}
    {% if hasLoggedInUser|default(false) and loggedInUser %}
        <div class="rbb-logged-in-user-data">{{ ('RBB.loggedInAs')|trans }} <strong>{{ loggedInUser.firstname }} {{ loggedInUser.lastname }}</strong></div>
    {% endif %}
{% endblock %}
