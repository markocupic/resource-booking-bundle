{% trans_default_domain "contao_default" %}

{% block rbb_booking_window__cancel_booking_form %}
    {# Start header #}
    {% block rbb_booking_window__cancel_booking_form__header %}
        <div class="rbb-booking-window-header">
            <h3 class="rbb-booking-window-header-title">
                {{ ('RBB.cancel')|trans }}: [[ activeResource.title ]]
            </h3>
            <button type="button" @click="hideBookingWindow" class="rbb-close-window" aria-label="Close" title="{{ ('RBB.close')|trans }}">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endblock %}
    {# Stop header #}

    {# Start info table #}
    {{ info_table|raw }}
    {# End info table #}

    {# Start delete repetitions switch #}
    {% block rbb_booking_window__cancel_booking_form__delete_repetitions_switch %}
        <div v-if="bookingWindow.showCancelBookingForm" class="rbb-form-check rbb-delete-repetitions">
            <input v-model="bookingWindow.deleteRepetitions" type="checkbox" class="rbb-form-check-input" id="deleteSiblingsWithSameBookingIdSwitch">
            <label class="rbb-form-check-label" for="deleteSiblingsWithSameBookingIdSwitch">{{ ('RBB.deleteRepetitions')|trans }}</label>
        </div>
    {% endblock %}
    {# End delete repetitions switch #}

    {{ messages|raw }}

    {# Start footer #}
    {% block rbb_booking_window__cancel_booking_form__footer %}
        <div class="rbb-booking-window-footer">
            <button type="button" class="rbb-btn rbb-btn--danger" v-if="bookingWindow.showCancelBookingButton" @click="cancelBookingRequest">
                {{ ('RBB.cancelResource')|trans }}
            </button>
            <button type="button" class="rbb-btn rbb-btn--secondary" @click="hideBookingWindow">
                {{ ('RBB.close')|trans }}
            </button>
        </div>
    {% endblock %}
    {# End footer #}
{% endblock %}
