{% trans_default_domain "contao_default" %}

{% block rbb_booking_window__info_table %}
    <div class="rbb-info-table rbb-layout-table">
        <div class="rbb-layout-box-inner">
            <div class="rbb-layout-row rbb-row-first">
                <div class="rbb-layout-cell rbb-column-0 rbb-column-first"><strong>{{ ('RBB.resource')|trans }}</strong></div>
                <div class="rbb-layout-cell rbb-column-1 rbb-column-last">[[ activeResource.title ]]<span v-if="activeResource.itemsAvailable > 1"> ([[ activeResource.itemsAvailable ]]x)</span></div>
            </div>
            <div class="rbb-layout-row">
                <div class="rbb-layout-cell rbb-column-0 rbb-column-first"><strong>{{ ('RBB.fullname')|trans }}</strong></div>
                <div class="rbb-layout-cell rbb-column-1 rbb-column-last">[[ loggedInUser.firstname ]] [[ loggedInUser.lastname ]]</div>
            </div>
            <div class="rbb-layout-row" v-if="bookingWindow.booking">
                <div class="rbb-layout-cell rbb-column-0 rbb-column-first"><strong>{{ ('RBB.bookingIdAndUuid')|trans }}</strong></div>
                <div class="rbb-layout-cell rbb-column-1 rbb-column-last">[[ bookingWindow.booking.id ]] / [[ bookingWindow.booking.bookingUuid ]]</div>
            </div>
            <div class="rbb-layout-row rbb-row-last">
                <div class="rbb-layout-cell rbb-column-0 rbb-column-first"><strong>{{ ('RBB.week')|trans }}</strong></div>
                <div class="rbb-layout-cell rbb-column-1 rbb-column-last">[[ activeWeek.weekNumber ]]/[[ activeWeek.year ]]: [[ activeWeek.dateStart ]] - [[ activeWeek.dateEnd ]]</div>
            </div>
        </div>
    </div>
{% endblock %}
