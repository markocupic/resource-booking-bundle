{% trans_default_domain "contao_default" %}

{% block rbb_booking_window__booking_form_inputs %}
    <div class="rbb-layout-box rbb-booking-form-inputs">
        <div class="rbb-layout-box-inner" :class="isBusy ? 'rbb-opacity-0' : 'rbb-opacity-1'">
            <div class="rbb-form-group" v-if="parseInt(activeResource.itemsAvailable) > 1">
                <label for="ctrlRequestedItems_{{ moduleKey }}">{{ ('RBB.formLegendItems')|trans }}</label>
                <select class="rbb-ctrl-requested-items rbb-form-control" id="ctrlRequestedItems_{{ moduleKey }}" name="requestedItems" @change="bookingFormValidationRequest()">
                    <option :value="i" v-for="i in parseInt(activeResource.itemsAvailable)"> [[ i ]] {{ ('RBB.pieces')|trans }}</option>
                </select>
                <small class="rbb-requested-items-help rbb-input-help-text">{{ ('RBB.formHelpItems')|trans }}</small>
            </div>
            <div class="rbb-form-group">
                <label for="ctrlBookingDescription_{{ moduleKey }}">{{ ('RBB.formLegendDescription')|trans }}</label>
                <input class="rbb-ctrl-booking-description rbb-form-control" id="ctrlBookingDescription_{{ moduleKey }}" maxlength="50" name="bookingDescription" placeholder="Kurzbeschreibung eingeben" type="text">
                <small class="rbb-booking-description-help rbb-input-help-text">{{ ('RBB.formHelpDescription')|trans }}</small>
            </div>

            <div class="rbb-form-group">
                <label for="ctrlRepeatUntil_{{ moduleKey }}">{{ ('RBB.formLegendRepetitions')|trans }}</label>
                <select class="rbb-js-repeat-until rbb-time-span-select rbb-form-control" id="ctrlRepeatUntil_{{ moduleKey }}" name="repeatUntil" @change="bookingFormValidationRequest()">
                    <option :value="row.tstamp" v-for="(row, rowIndex) in bookingRepeatsSelection">[[ row.optionText ]]</option>
                </select>
            </div>
        </div>
    </div>
{% endblock %}
