{% trans_default_domain "contao_default" %}

{#
    Fields of the booking form (rendered on the server). The values sent are filled in again
    (variable "form"): use value="{{ form.<name>|default('') }}" in own fields. Custom fields
    must be permitted in the app configuration (permitted_form_fields).
#}
{% block rbb_booking_window__booking_form_inputs %}
    <div class="rbb-layout-box rbb-booking-form-inputs">
        <div class="rbb-layout-box-inner">
            {% if activeResource.itemsAvailable|default(1) > 1 %}
                <div class="rbb-form-group">
                    <label for="ctrlRequestedItems_{{ moduleKey }}">{{ ('RBB.formLegendItems')|trans }}</label>
                    <select class="rbb-ctrl-requested-items rbb-form-control" id="ctrlRequestedItems_{{ moduleKey }}" name="requestedItems">
                        {% for i in 1..activeResource.itemsAvailable %}
                            <option value="{{ i }}"{{ i == form.requestedItems|default(1) ? ' selected' }}>{{ i }} {{ ('RBB.pieces')|trans }}</option>
                        {% endfor %}
                    </select>
                    <small class="rbb-requested-items-help rbb-input-help-text">{{ ('RBB.formHelpItems')|trans }}</small>
                </div>
            {% endif %}
            <div class="rbb-form-group">
                <label for="ctrlBookingDescription_{{ moduleKey }}">{{ ('RBB.formLegendDescription')|trans }}</label>
                <input class="rbb-ctrl-booking-description rbb-form-control" id="ctrlBookingDescription_{{ moduleKey }}" maxlength="50" name="bookingDescription" placeholder="Kurzbeschreibung eingeben" type="text" value="{{ form.bookingDescription|default('') }}">
                <small class="rbb-booking-description-help rbb-input-help-text">{{ ('RBB.formHelpDescription')|trans }}</small>
            </div>

            <div class="rbb-form-group">
                <label for="ctrlRepeatUntil_{{ moduleKey }}">{{ ('RBB.formLegendRepetitions')|trans }}</label>
                <select class="rbb-js-repeat-until rbb-time-span-select rbb-form-control" id="ctrlRepeatUntil_{{ moduleKey }}" name="repeatUntil">
                    {% for option in bookingRepeatsSelection %}
                        <option value="{{ option.tstamp }}"{{ option.tstamp == form.repeatUntil|default('') ? ' selected' }}>{{ option.optionText }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
{% endblock %}
