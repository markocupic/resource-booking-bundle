{% trans_default_domain "contao_default" %}

{% block rbb_booking_window__booking_form %}
    {# Start header #}
    <div class="rbb-booking-window-header">
        <h3 class="rbb-booking-window-header-title" id="rbbBookingWindowTitle_{{ moduleKey }}" v-if="bookingWindow.action === 'showBookingForm'">
            {{ ('RBB.book')|trans }}: [[ activeResource.title ]]
        </h3>
        <button class="rbb-close-window" type="button" @click="hideBookingWindow" aria-label="{{ ('RBB.close')|trans }}" title="{{ ('RBB.close')|trans }}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {# End header #}

    {{ info_table|raw }}

    {{ messages|raw }}

    {# Messages per form field, linked to the fields with aria-describedby (see setFieldErrors() in app.js) #}
    {% block rbb_booking_window__booking_form__field_errors %}
        <div class="rbb-field-errors rbb-alert rbb-alert--danger" v-if="Object.keys(fieldErrors).length" role="alert">
            {{ rbb_icon('fa-exclamation-circle','rbb-icon-2x')|raw }}
            <ul class="rbb-field-errors-list">
                <li v-for="(message, field) in fieldErrors" :id="getFieldErrorId(field)">[[ message ]]</li>
            </ul>
        </div>
    {% endblock %}

    {# Start booking preview #}
    {% block rbb_booking_window__booking_form__booking_preview %}
        <details class="rbb-booking-preview" v-if="bookingWindow.response.isBookable === false && isBusy === false">
            {% block rbb_booking_window__booking_form__booking_preview_button %}
                {# Start toggle button #}
                <summary class="rbb-btn rbb-btn--danger rbb-btn--sm">
                    {{ ('RBB.showOccupiedResources')|trans }}
                </summary>
                {# End toggle button #}
            {% endblock %}

            {% block rbb_booking_window__booking_form__booking_preview_table %}
                {# Start booking preview table #}
                <div class="rbb-booking-preview-table rbb-layout-table" id="bookingPreview_{{ moduleKey }}">
                    <div class="rbb-layout-box-inner">
                        <div class="rbb-layout-row" :class="!slot.isBookable ? 'not-bookable' : 'bookable'" v-for="(slot, index) in bookingWindow.response.slots">
                            <div class="rbb-layout-cell">
                                <small>[[ slot.datimSpanString ]]: </small>
                            </div>
                            <div class="rbb-layout-cell">
                                <span v-if="slot.isValidTimeSlot === false"><small>{{ ('RBB.ERR.invalidTimeSlot')|trans }}</small></span>
                                <span v-else-if="slot.hasValidItemCount === false"><small>{{ ('RBB.ERR.invalidItemsBooked')|trans }}</small></span>
                                <span v-else-if="!slot.isInBookingWindow"><small>{{ ('RBB.ERR.invalidStartOrEndTime')|trans }}</small></span>
                                <span v-else-if="slot.isInBlockedPeriod && slot.blockedPeriodDescription"><small>[[ slot.blockedPeriodDescription ]]</small></span>
                                <span v-else-if="slot.isInBlockedPeriod"><small>{{ ('RBB.blocked')|trans }}</small></span>
                                <span v-else-if="slot.isAvailableOnWeekday === false"><small>{{ ('RBB.notAvailable')|trans }}</small></span>
                                <span v-else-if="!slot.canFulfillRequestedItems"><small>{{ ('RBB.ERR.thisSlotHasNotEnoughItemsAvailable')|trans }}</small></span>
                                <span v-else-if="slot.isFullyBooked"><small>{{ ('RBB.ERR.resourceIsAlreadyFullyBooked')|trans }}</small></span>
                                <span v-else><small>{{ ('RBB.MSG.resourceAvailable')|trans }}</small></span>
                            </div>
                        </div>
                    </div>
                </div>
                {# End booking preview table #}
            {% endblock %}
        </details>
    {% endblock %}
    {# End booking preview #}

    {# Start booking form #}
    {% block rbb_booking_window__booking_form__form %}
        <form v-if="!bookingWindow.response.isBooked" :aria-busy="isBusy ? 'true' : 'false'" class="rbb-booking-form rbb-js-booking-form" :class="isBusy ? 'rbb-opacity-0' : 'rbb-opacity-1'">
            <div class="rbb-booking-form-grid">
                <!-- start booking table -->
                <div class="rbb-layout-table rbb-booking-table-booking-form" v-if="rows.length > 0">
                    <div class="rbb-layout-box-inner rbb-custom-scroll-bar-thin">
                        {# Start checkbox table #}
                        <div class="rbb-layout-row">
                            <div class="rbb-layout-cell rbb-cell-headline rbb-time-slot-indicator"><strong>{{ ('RBB.time')|trans }}</strong></div>
                            <div class="rbb-layout-cell rbb-cell-headline" :data-day-index="weekday.index" v-for="(weekday, index) in weekdays"><strong>[[ weekday.titleShort ]]</strong></div>
                        </div>
                        <div class="rbb-layout-row" :class="row.rowData.cssRowClass" :data-row-index="rowIndex" v-for="(row, rowIndex) in rows">
                            <div class="rbb-layout-cell rbb-time-slot-indicator">[[ timeSlots[rowIndex].timeSpanString ]]</div>
                            <div class="rbb-layout-cell rbb-time-slot-cell" :data-day-index="slot.index" :data-isbookable="slot.isBookable && slot.isInBookingWindow" :data-isbooked="slot.hasBookings" :data-isfullybooked="slot.isFullyBooked" :data-isoutsidebookingwindow="!slot.isInBookingWindow" :data-isavailableonweekday="slot.isAvailableOnWeekday" :data-isinblockedperiod="slot.isInBlockedPeriod" v-for="(slot, colIndex) in row.cellData">
                                <div v-if="slot.isBookable && !slot.isFullyBooked">
                                    <div class="rbb-form-check">
                                        <input class="rbb-form-check-input" type="checkbox" :id="slot.bookingCheckboxId" :aria-label="slot.datimSpanString" :value="slot.bookingCheckboxValue" v-model="bookingWindow.selectedTimeSlots" @change="bookingFormValidationRequest()">
                                        <label class="rbb-form-check-label" :for="slot.bookingCheckboxId"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {# End checkbox table #}
                    </div>
                </div>

                {# Small screens: the same time slots as a list, one day at a time (the checkboxes share the v-model of the table) #}
                {% block rbb_booking_window__booking_form__slot_list %}
                    <div class="rbb-booking-slot-picker" v-if="rows.length > 0">
                        <div class="rbb-booking-day-chips" role="group" aria-label="{{ ('RBB.filterDay')|trans }}">
                            <button v-for="weekday in weekdays" type="button" class="rbb-booking-day-chip" :aria-pressed="bookingWindowDayIndex === weekday.index ? 'true' : 'false'" :aria-label="weekday.title + ', ' + weekday.date + (countSelectedSlotsOfDay(weekday.index) ? ': ' + countSelectedSlotsOfDay(weekday.index) + ' {{ ('RBB.selected')|trans|e('js') }}' : '')" @click="bookingWindowDayIndex = weekday.index">
                                <span class="rbb-booking-day-chip-name" aria-hidden="true">[[ getShortWeekday(weekday) ]]</span>
                                <span class="rbb-booking-day-chip-date" aria-hidden="true">[[ getShortDate(weekday) ]]</span>
                                <span class="rbb-booking-day-chip-count" v-if="countSelectedSlotsOfDay(weekday.index)" aria-hidden="true">[[ countSelectedSlotsOfDay(weekday.index) ]]</span>
                            </button>
                        </div>
                        <ul class="rbb-booking-slot-list">
                            <template v-for="(row, rowIndex) in rows">
                                <template v-for="slot in row.cellData">
                                    <li v-if="slot.index === bookingWindowDayIndex" class="rbb-booking-slot-list-item" :data-isselectable="slot.isBookable && !slot.isFullyBooked ? 'true' : 'false'">
                                        <label class="rbb-booking-slot-list-label" v-if="slot.isBookable && !slot.isFullyBooked" :for="'list_' + slot.bookingCheckboxId">
                                            <input class="rbb-form-check-input" type="checkbox" :id="'list_' + slot.bookingCheckboxId" :aria-label="slot.datimSpanString" :value="slot.bookingCheckboxValue" v-model="bookingWindow.selectedTimeSlots" @change="bookingFormValidationRequest()">
                                            <span class="rbb-booking-slot-list-time">[[ timeSlots[rowIndex].timeSpanString ]]</span>
                                        </label>
                                        <div class="rbb-booking-slot-list-label" v-else>
                                            <span class="rbb-booking-slot-list-time">[[ timeSlots[rowIndex].timeSpanString ]]</span>
                                            <span class="rbb-booking-slot-list-status" v-if="slot.isInBlockedPeriod && slot.blockedPeriodDescription">[[ slot.blockedPeriodDescription ]]</span>
                                            <span class="rbb-booking-slot-list-status" v-else-if="slot.isInBlockedPeriod">{{ ('RBB.blocked')|trans }}</span>
                                            <span class="rbb-booking-slot-list-status" v-else-if="slot.isFullyBooked">{{ ('RBB.legend.fullyBooked')|trans }}</span>
                                            <span class="rbb-booking-slot-list-status" v-else>{{ ('RBB.notAvailable')|trans }}</span>
                                        </div>
                                    </li>
                                </template>
                            </template>
                        </ul>
                    </div>
                {% endblock %}
                {{ booking_form_inputs|raw }}
            </div>
        </form>
    {% endblock %}
    {# End booking form #}

    {# Start footer #}
    {% block rbb_booking_window__booking_form__footer %}
        <div class="rbb-booking-window-footer">
            <button class="rbb-btn rbb-btn--primary" type="button" v-if="!bookingWindow.response.isBooked" @click="bookingRequest">
                {{ ('RBB.bookResource')|trans }}
            </button>
            <button class="rbb-btn rbb-btn--secondary rbb-js-close-booking-window" type="button" @click="hideBookingWindow">
                {{ ('RBB.close')|trans }}
            </button>
        </div>
    {% endblock %}
    {# End footer #}
{% endblock %}
