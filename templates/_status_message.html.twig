{% trans_default_domain "contao_default" %}

{% block rbb_status_message %}
    <template v-if="isReady === false && lastResponseCode !== 200">
        <div class="rbb-status-message" v-if="lastResponseCode === 401">
            {{ ('RBB.ERR.401')|trans }}
        </div>
        <div class="rbb-status-message" v-else>
            {{ ('RBB.ERR.general')|trans }}
        </div>
    </template>
{% endblock %}
