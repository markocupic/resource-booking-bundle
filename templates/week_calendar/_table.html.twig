{% trans_default_domain "contao_default" %}

{% block rbb_week_calendar_window__table %}
    <template v-if="rows.length > 0">
        {# Day selection, only displayed on small screens (one day at a time) #}
        {% block rbb_week_calendar_window__day_tabs %}
            <div class="rbb-day-tabs" role="group" aria-label="{{ ('RBB.filterDay')|trans }}">
                <button v-for="weekday in weekdays" type="button" class="rbb-day-tab" :data-day-index="weekday.index" :aria-pressed="activeDayIndex === weekday.index ? 'true' : 'false'" :aria-label="weekday.title + ', ' + weekday.date" @click="activeDayIndex = weekday.index" @keydown.left.prevent="selectAdjacentDay(-1, true)" @keydown.right.prevent="selectAdjacentDay(1, true)">
                    <span class="rbb-day-tab-name" aria-hidden="true">[[ getShortWeekday(weekday) ]]</span>
                    <span class="rbb-day-tab-date" aria-hidden="true">[[ getShortDate(weekday) ]]</span>
                </button>
            </div>
        {% endblock %}
        {# The div based layout is exposed to assistive technology as a table (rows, column and row headers) #}
        <div class="rbb-layout-table rbb-booking-table-main" :aria-busy="isBusy ? 'true' : 'false'" role="table" :aria-label="'{{ ('RBB.weekCalendar')|trans|e('js') }}: ' + (activeResource.title || '') + ', ' + (activeWeek.daySpan || '')" :data-activedayindex="activeDayIndex" @touchstart.passive="onTableTouchStart" @touchend="onTableTouchEnd">
            <div class="rbb-layout-box-inner" role="rowgroup">
                <div class="rbb-layout-row rbb-layout-row-head" role="row">
                    <div class="rbb-layout-cell rbb-cell-headline rbb-time-slot-indicator" role="columnheader"><strong>{{ ('RBB.time')|trans }}</strong></div>
                    <div class="rbb-layout-cell rbb-cell-headline" role="columnheader" v-for="(weekday, index) in weekdays" :data-day-index="weekday.index"><strong class="rbb-weekday-title">[[ weekday.title ]]</strong> <span class="rbb-weekday-date">[[ weekday.date ]]</span></div>
                </div>

                <div v-for="(row, rowIndex) in rows" :data-row-index="rowIndex" :id="row.rowData.cssRowId" class="rbb-layout-row" :class="row.rowData.cssRowClass" role="row">
                    <!-- time indicator -->
                    <div class="rbb-layout-cell rbb-time-slot-indicator" role="rowheader" :class="timeSlots[rowIndex].cssClass ? timeSlots[rowIndex].cssClass : ''">[[ timeSlots[rowIndex].timeSpanString ]]</div>
                    <!-- slots -->
                    <div class="rbb-layout-cell rbb-time-slot-cell" role="cell" v-for="(slot, colIndex) in row.cellData" :class="timeSlots[rowIndex].cssClass ? timeSlots[rowIndex].cssClass : ''" :data-day-index="slot.index" :data-ismemberloggedin="slot.isMemberLoggedIn" :data-iscancelable="slot.isCancelable" :data-isfullybooked="slot.isFullyBooked" :data-isbookable="!slot.isCancelable && slot.isBookable" :data-isbooked="slot.hasBookings" :data-isoutsidebookingwindow="!slot.isInBookingWindow" :data-isavailableonweekday="slot.isAvailableOnWeekday" :data-isinblockedperiod="slot.isInBlockedPeriod" :data-hasunconfirmedbookings="slot.hasBookings && slot.bookings.some((booking) => !booking.confirmed) ? 'true' : 'false'">
                        {{ time_slot_cell|raw }}
                    </div>
                </div>
            </div>
        </div>
    </template>
{% endblock %}
